# Telegram API credentials (get yours at https://my.telegram.org -> API development tools)
# Fill these in with YOUR OWN values. Never commit your real .env file.
API_ID=
API_HASH=

# Name of the Telethon session file (without the .session extension).
# Pick any name you like — it will be created automatically on first login.
SESSION_NAME=

# One or more channels to scrape, comma-separated. Any of these forms work:
#   public username:   somechannel   (or @somechannel / https://t.me/somechannel)
#   private invite:     https://t.me/+xxxxxxxxxxxx  (you must already be a member)
#   numeric id:         -1001234567890
CHANNELS=

# Output directory for JSON/CSV files and (optionally) downloaded media.
OUTPUT_DIR=output
