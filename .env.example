# Telegram API credentials (https://my.telegram.org -> API development tools)
API_ID=123456
API_HASH=your_api_hash_here

# Name of the Telethon session file (without the .session extension).
# Created automatically on first run if it doesn't exist yet.
SESSION_NAME=session

# One or more channels, comma-separated. Any of these forms work:
#   public username:   mychannel   (or @mychannel / https://t.me/mychannel)
#   private invite:     https://t.me/+xxxxxxxxxxxx  (you must already be a member)
#   numeric id:         -1001234567890
CHANNELS=mychannel

# Output directory for JSON/CSV files and (optionally) downloaded media.
OUTPUT_DIR=output
