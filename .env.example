# Telegram API credentials — get these at https://my.telegram.org
# (log in -> API development tools -> create an app -> copy api_id / api_hash)
API_ID = ""
API_HASH = ""

# Your Telegram phone number, with country code.
# Needed to log in: Telegram will send a login code to your Telegram app,
# which the script will ask you to type in the first time you run it.
PHONE = "+98"

# Session file name (any name you like). Created automatically after your
# first successful login, so you won't be asked for the code again.
SESSION_NAME = "my_session"

# Channel(s) or group(s) to scrape. Separate multiple with a comma.
# Accepts a username, a t.me link, a private invite link, or a numeric id —
# see README.md / README.fa.md for the exact formats.
CHANNELS = ""

# Folder where JSON/CSV output (and media, if enabled) will be saved.
# For full Windows paths, prefer forward slashes, e.g. "C:/Users/Name/output".
OUTPUT_DIR = "output"
